# ---------------------------------------------------------------------------
# Copiá este archivo como .env y completá SOLO el proveedor que vayas a usar.
#
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# El archivo .env está en .gitignore: nunca se sube a GitHub.
# ---------------------------------------------------------------------------


# ===========================================================================
#  1. QUÉ MODELO USA EL AGENTE
# ===========================================================================

# claude | openai | gemini
PROVEEDOR=claude

# --- Claude (Anthropic) ---  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-4-5
# (el más rápido y barato para probar; en la web elegís cualquier otro)

# --- OpenAI ---  https://platform.openai.com/api-keys
OPENAI_API_KEY=
MODELO_OPENAI=gpt-5

# --- Gemini (Google) ---  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODELO_GEMINI=gemini-2.5-pro

# Si no sabés qué modelo poner, dejá el que viene: la plataforma de pruebas
# le pregunta al proveedor cuáles tiene hoy y te los muestra en una lista.


# ===========================================================================
#  2. DÓNDE SE GUARDAN LAS CONVERSACIONES
# ===========================================================================

# test        → SQLite: un archivo en tu computadora. No instalás nada.
# produccion  → Postgres: para cuando hay varios procesos atendiendo.
MODO=test

# --- MODO=test ---
SQLITE_RUTA=datos/conversaciones.db

# --- MODO=produccion ---
# Formato: postgresql://usuario:clave@servidor:puerto/base
POSTGRES_DSN=

# Para producción hacen falta dos paquetes que no vienen instalados:
#
#   pip install -r requirements-produccion.txt
#
# Ojo con los dos: langgraph-checkpoint-postgres tiene que ser 3.x (la 2.x
# rompe el entorno), y psycopg va con [binary] o en Windows falla con
# "no pq wrapper available". El requirements-produccion.txt ya los tiene
# con la versión correcta.


# ===========================================================================
#  3. COMPORTAMIENTO Y COSTO
# ===========================================================================

# Caché del prompt del sistema: hace que el proveedor lo guarde de su lado
# y te cobre una fracción a partir del segundo mensaje.
# (En Claude se activa a mano; en OpenAI y Gemini es automático.)
CACHE=true

# Máximo de tokens que puede escribir el agente en cada respuesta
MAX_TOKENS=4096

# Cuántos mensajes de la conversación recuerda.
# Más memoria = más contexto, pero también más costo por mensaje.
MEMORIA_MENSAJES=20

# Archivo con el prompt del sistema (la personalidad del agente).
# Se relee en cada mensaje: podés editarlo con el agente andando.
PROMPT_SISTEMA=prompts/sistema.md

# La zona horaria del negocio (no la tuya, si estás armando esto para un
# cliente). El agente la usa para saber qué día es "hoy" — sin esto no
# puede convertir "el sábado" o "mañana" en una fecha concreta — y para
# guardar los turnos de anotar_reserva en el huso horario correcto.
# Nombre de la lista IANA, por ejemplo: America/Argentina/Buenos_Aires,
# Europe/Lisbon, Europe/Madrid.
ZONA_HORARIA=UTC


# ===========================================================================
#  4. TELEGRAM
# ===========================================================================

# El token que te da @BotFather. Abrí https://t.me/BotFather, mandale
# /newbot y seguile la conversación: al final te lo pega en el chat.
#
# Con esto puesto ya podés arrancar el bot:
#
#   python bot_telegram.py
#
# Corre en tu computadora: no hace falta dominio, ni HTTPS, ni abrir puertos.
# Si no vas a usar Telegram, dejalo vacío y no pasa nada.
TELEGRAM_TOKEN=


# ===========================================================================
#  5. WHATSAPP  (con Chatwoot en el medio)
# ===========================================================================
#
# Esto es para  python webhook_chatwoot.py  y necesita un servidor con
# dominio: WhatsApp va por webhook, así que alguien tiene que poder entrar.
# Si solo vas a usar la terminal, la web o Telegram, saltealo entero.
#
# El recorrido de un mensaje:
#
#   persona → WhatsApp → Meta → Chatwoot → tu webhook → el agente
#                                  ↑                        │
#                                  └──── la respuesta ──────┘
#
# Ojo con esto, que ahorra tiempo: **el agente NO le habla a Meta**, le habla
# a Chatwoot. Por eso acá no hay token de WhatsApp, ni App Secret, ni firma
# HMAC: de eso se encarga Chatwoot cuando conectás el inbox. Vos solo
# necesitás las cuatro variables de abajo.


# --- Chatwoot ---
# La dirección de tu Chatwoot, con https:// (la barra final da igual)
CHATWOOT_URL=
# Perfil → Configuración del perfil → Token de acceso a la API
CHATWOOT_TOKEN=
# El número que aparece en la URL cuando entrás: /app/accounts/1/...
CHATWOOT_CUENTA_ID=1

# El secreto que va en la URL del webhook:
#
#   https://tu-dominio.com/chatwoot/<CHATWOOT_WEBHOOK_TOKEN>
#
# Chatwoot NO firma sus webhooks, así que esto es lo único que separa un
# mensaje de verdad de cualquiera que descubra tu dominio. Generá uno largo
# y al azar, no lo escribas a mano:
#
#   python -c "import secrets; print(secrets.token_hex(24))"
#
CHATWOOT_WEBHOOK_TOKEN=

# Etiqueta que apaga al bot en una conversación (el traspaso a una persona).
# Se la ponés desde la bandeja y el agente se calla en ese chat.
CHATWOOT_ETIQUETA_HUMANO=humano


# --- Juntar los mensajes cortados ---
# La gente en WhatsApp escribe "hola" / "queria preguntar" / "por el precio"
# en tres mensajes seguidos. Sin esto el agente contesta tres veces, y las
# tres mal: recién el tercero trae la pregunta entera.
#
# Cuántos segundos espera juntando la ráfaga antes de contestar.
# Con 0 contesta cada mensaje al toque (y se pisa).
BUFFER_SEGUNDOS=8

# El puerto donde escucha el webhook. En un contenedor dejalo en 8000.
PUERTO=8000


# ===========================================================================
#  6. GOOGLE CALENDAR  (turnos y reservas de verdad)
# ===========================================================================
#
# Opcional. Sin esto, anotar_reserva (herramientas.py) deja la reserva
# anotada en Chatwoot nada más, pendiente de que alguien la confirme a
# mano. Con esto, la confirma sola: chequea el horario contra el calendario
# del negocio y crea el turno.
#
# Se conecta con una CUENTA DE SERVICIO, no con el login del dueño del
# negocio: no hay ninguna pantalla de "Iniciar sesión con Google" de por
# medio. El paso a paso para sacar estos dos datos está en AGENTS.md.

# El JSON entero que te da Google Cloud al crear la cuenta de servicio,
# pegado en una sola línea (con las comillas y las \n del private_key tal
# cual vienen).
GOOGLE_SERVICE_ACCOUNT_JSON=

# El ID del calendario que el negocio compartió con el email de esa cuenta
# de servicio (Configuración del calendario → Integrar calendario). Un
# calendario personal de Google suele tener el mismo ID que el email de la
# cuenta; uno creado a propósito para esto es algo así como
# "xxxxxxxx@group.calendar.google.com".
GOOGLE_CALENDAR_ID=

# --- Varios profesionales, cada uno con su propia agenda (opcional) ---
#
# Si el negocio tiene un solo profesional (o el calendario es del negocio
# en general, no de una persona puntual), dejá esto vacío: se usa
# GOOGLE_CALENDAR_ID de arriba, como siempre.
#
# Con dos o más, el modelo va a preguntar con qué profesional antes de
# reservar. Formato: "Nombre:calendar_id" separados por coma. Todos
# comparten la MISMA cuenta de servicio (GOOGLE_SERVICE_ACCOUNT_JSON) —
# cada profesional solo comparte SU calendario con ese email (mismo paso
# a paso que arriba, una vez por persona). Ver AGENTS.md, "Varios
# profesionales".
#     PROFESIONALES=Dra. García:xxxxxxxx@group.calendar.google.com,Dr. Pérez:yyyyyyyy@group.calendar.google.com
PROFESIONALES=

# --- Aprobación manual antes de confirmar (opcional) ---
#
# Con calendario conectado, anotar_reserva() confirma el turno de una. Si
# el negocio prefiere revisar cada reserva antes de que quede firme, poné
# esto en true: el turno queda "tentative" en el calendario (el horario se
# lo lleva igual, nadie más lo puede tomar) y a Chatwoot le llega un link
# para aprobarlo o rechazarlo con un clic, sin login. Ver AGENTS.md.
RESERVA_REQUIERE_APROBACION=false

# El dominio público de este servidor (el mismo que usás en la URL del
# webhook de Chatwoot, sin la barra final). Hace falta para armar esos
# links de aprobar/rechazar.
URL_PUBLICA=

# El secreto que firma esos links, mismo criterio que
# CHATWOOT_WEBHOOK_TOKEN de arriba: generalo con
#     python -c "import secrets; print(secrets.token_hex(24))"
RESERVA_SECRETO=

# --- Horario de atención (opcional) ---
#
# Sin nada de esto, anotar_reserva acepta cualquier fecha y hora — antes de
# esto, lo único que sabía el modelo del horario era lo que decía su propio
# prompt (prompts/sistema.md), sin que nada lo hiciera cumplir de verdad.

# Para un turno corrido (el caso simple, sin corte al medio). HH:MM, 24
# horas. Vacío = sin restricción de ese lado.
HORARIO_DESDE=
HORARIO_HASTA=

# Para horario PARTIDO (con un corte al medio, por ejemplo cerrado de
# 15 a 18). Si tiene algo puesto, manda por sobre HORARIO_DESDE/HASTA de
# arriba. Formato: pares "HH:MM-HH:MM" separados por coma.
#     HORARIO_FRANJAS=09:00-15:00,18:00-23:00
HORARIO_FRANJAS=

# Días en que el negocio no atiende, separados por coma (en castellano,
# con o sin tilde): "domingo" o "lunes, domingo". Vacío = ningún día
# cerrado.
DIAS_CERRADOS=

# --- Política de cancelación (opcional) ---
#
# Si el turno es en menos de estas horas, cancelar_mi_reserva y
# reprogramar_mi_reserva no lo tocan solas: le avisan a la persona que
# hable directo con el negocio. 0 (el default) = sin restricción, la
# persona puede cancelar/mover su turno por chat sin importar cuán cerca
# esté.
CANCELACION_HORAS_MINIMAS=0

# --- Recordatorios automáticos (opcional) ---
#
# Necesita Google Calendar Y Chatwoot configurados arriba. Correr
#     python recordatorios.py
# cada tanto (una Scheduled Task de Coolify, un cron) avisa por WhatsApp a
# quien tenga un turno confirmado dentro de estas horas, si todavía no se
# le avisó. Ver AGENTS.md.

# Cuántas horas antes del turno se manda el recordatorio.
RECORDATORIO_HORAS_ANTES=24

# Margen extra, en minutos, sobre RECORDATORIO_HORAS_ANTES — cada corrida
# barre desde AHORA hasta HORAS_ANTES + este margen, así que no hace falta
# que coincida con cada cuánto programás la corrida (eso ya no puede
# saltearse turnos: ver recordatorios.py). Dejalo en 60 salvo que quieras
# mandar el aviso con más de una hora de anticipación de sobra.
RECORDATORIO_VENTANA_MINUTOS=60

# --- Estadísticas para el dueño del negocio (opcional) ---
#
# Turnos por mes, nuevos vs. recurrentes — ver AGENTS.md, "Estadísticas
# para el dueño del negocio". Necesita Google Calendar Y Chatwoot Y
# POSTGRES_DSN (MODO=produccion) para tener algo que mostrar.

# El secreto que protege https://tu-dominio.com/estadisticas — mismo
# criterio que RESERVA_SECRETO: un token en la URL, sin login. Generalo con:
#     python -c "import secrets; print(secrets.token_hex(24))"
# Sin esto, /estadisticas da 404 — nadie la puede ver por accidente.
DASHBOARD_SECRETO=


# ===========================================================================
#  7. ALERTAS AL DUEÑO DEL BOT  (opcional, solo web/webhook.py)
# ===========================================================================
#
# Un bot de Telegram APARTE del de la sección 4 (ese es para clientes; en
# producción puede ni estar configurado). Este solo te avisa a vos cuando
# algo se rompe de verdad (por ejemplo, se cae la conexión a Postgres) —
# para que te enteres antes que un cliente te escriba enojado.
#
# Sin las dos variables, no avisa nada y no rompe nada.

# El token que te da @BotFather (mismo paso a paso que TELEGRAM_TOKEN, pero
# con un bot nuevo, solo para vos).
ALERTA_TELEGRAM_TOKEN=

# El chat al que mandarte el aviso. Hablale un momento a @userinfobot y te
# contesta con tu chat_id.
ALERTA_TELEGRAM_CHAT_ID=
