# ---------------------------------------------------------------------------
# Copiá este archivo como .env y completá SOLO el proveedor que vayas a usar.
#
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# El archivo .env está en .gitignore: nunca se sube a GitHub.
# ---------------------------------------------------------------------------


# ===========================================================================
#  1. QUÉ MODELO USA EL AGENTE
# ===========================================================================

# claude | openai | gemini
PROVEEDOR=claude

# --- Claude (Anthropic) ---  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-4-5
# (el mas rapido y barato para probar; en la web elegis cualquier otro)

# --- OpenAI ---  https://platform.openai.com/api-keys
OPENAI_API_KEY=
MODELO_OPENAI=gpt-5

# --- Gemini (Google) ---  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODELO_GEMINI=gemini-2.5-pro

# Si no sabés qué modelo poner, dejá el que viene: la plataforma de pruebas
# le pregunta al proveedor cuáles tiene hoy y te los muestra en una lista.


# ===========================================================================
#  2. DÓNDE SE GUARDAN LAS CONVERSACIONES
# ===========================================================================

# test        → SQLite: un archivo en tu computadora. No instalás nada.
# produccion  → Postgres: para cuando hay varios procesos atendiendo.
MODO=test

# --- MODO=test ---
SQLITE_RUTA=datos/conversaciones.db

# --- MODO=produccion ---
# Formato: postgresql://usuario:clave@servidor:puerto/base
POSTGRES_DSN=

# Para producción hace falta instalar el conector:
#   pip install langgraph-checkpoint-postgres


# ===========================================================================
#  3. COMPORTAMIENTO Y COSTO
# ===========================================================================

# Caché del prompt del sistema: hace que el proveedor lo guarde de su lado
# y te cobre una fracción a partir del segundo mensaje.
# (En Claude se activa a mano; en OpenAI y Gemini es automático.)
CACHE=true

# Máximo de tokens que puede escribir el agente en cada respuesta
MAX_TOKENS=4096

# Cuántos mensajes de la conversación recuerda.
# Más memoria = más contexto, pero también más costo por mensaje.
MEMORIA_MENSAJES=20

# Archivo con el prompt del sistema (la personalidad del agente).
# Se relee en cada mensaje: podés editarlo con el agente andando.
PROMPT_SISTEMA=prompts/sistema.md


# ===========================================================================
#  4. CUANDO EL AGENTE ATIENDA MENSAJERIA  (todavía no hace falta)
# ===========================================================================
#
# Nada de esto se usa mientras el agente corra en tu computadora. Están acá
# para que sepas qué va a hacer falta cuando lo conectes a Telegram o a
# WhatsApp, y para que el .env no cambie de forma en el camino.
#
# Descomentá solo las que uses.


# --- Telegram ---
# El token que te da @BotFather
# TELEGRAM_TOKEN=


# --- WhatsApp (Meta) ---
# Lo que configurás en el panel de Meta
# WHATSAPP_TOKEN=
# WHATSAPP_TELEFONO_ID=
# WHATSAPP_VERIFY_TOKEN=
# Con esto se verifica que el mensaje venga de Meta de verdad y no de
# cualquiera que descubrió tu URL. NO es opcional en producción.
# WHATSAPP_APP_SECRET=


# --- Chatwoot (opcional) ---
# Si lo usás, el agente atiende desde la bandeja de Chatwoot: tenés el
# historial, el multicanal y podés sacarle la conversación al bot poniéndole
# una etiqueta. Si lo dejás vacío, el agente habla directo con el canal.
# CHATWOOT_URL=
# CHATWOOT_TOKEN=
# CHATWOOT_CUENTA_ID=
# Etiqueta que apaga al bot en una conversación (el traspaso a una persona)
# CHATWOOT_ETIQUETA_HUMANO=humano


# --- Redis: juntar los mensajes cortados ---
# La gente en WhatsApp escribe "hola" / "queria preguntar" / "por el precio"
# en tres mensajes seguidos. Sin esto, el agente contesta tres veces.
# Con esto, espera, los junta y contesta una sola vez.
# REDIS_URL=redis://localhost:6379
# Cuánto espera antes de dar por terminada la ráfaga
# BUFFER_SEGUNDOS=6
